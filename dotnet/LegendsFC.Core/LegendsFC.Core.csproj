<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Unity package source in core/ with plain dotnet, so it can be tested anywhere.
       Unity compiles the same files through core/LegendsFC.Core.asmdef. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>LegendsFC.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../core/src/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests can set up match situations (LiveMatch test hooks); Unity's asmdef doesn't see this. -->
    <InternalsVisibleTo Include="LegendsFC.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
